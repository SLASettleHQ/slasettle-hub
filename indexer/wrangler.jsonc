{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slasettle-indexer-v02",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slasettle-indexer-v02",
      "database_id": "17b47ce0-bdc6-46eb-ba72-0513804b7827",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RPC_URL": "https://soroban-testnet.stellar.org",
    "NETWORK_PASSPHRASE": "Test SDF Network ; September 2015",
    "WATCHER_REGISTRY_CONTRACT_ID": "CDTIVQ6I77EMFP42522RIFKMSMJID3BDLNR5LPLJEGVAS4Q2DJDMN3DY",
    "SLA_VAULT_CONTRACT_ID": "CA5R7V5IGMYOBRSAMP4R5MWURSNTY6565NSKEEVR6626PLC3VM2A3EZ2",
    "START_LEDGER": "5396411",
    "ROUND_LENGTH_SECONDS": "60",
    "ALLOWED_ORIGINS": "http://localhost:3000,https://slasettle-c6zukmevs-hollujays-projects.vercel.app,https://slasettle-web.vercel.app"
  }
}
