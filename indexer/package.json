{
  "name": "slasettle-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indexes watcher_registry and sla_vault contract events and serves them over the API spec'd in SLASettle-indexer-api-spec.md.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.1.0",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
