{
  "name": "slasettle-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indexes watcher_registry and sla_vault contract events and serves them over the HTTP API documented in apps/docs/api.md.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "node --import tsx --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "better-sqlite3": "13.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
