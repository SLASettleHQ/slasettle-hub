# Refuse to run scripts under a Node version that doesn't satisfy each
# package's declared "engines" field, instead of proceeding and failing
# later with an obscure error from deep inside a dependency (e.g. undici
# requiring a worker_threads API that only exists on Node 24+). This repo
# is pinned to Node 24 LTS via .nvmrc — run `nvm use` before installing or
# testing if your shell's default node is older.
engine-strict=true
