# Soroban RPC endpoint for the target network (e.g. a Testnet or Mainnet
# Soroban RPC provider). Supplied per deployment.
NEXT_PUBLIC_SOROBAN_RPC_URL=

# Network passphrase for the target Stellar network. Supplied per deployment.
NEXT_PUBLIC_NETWORK_PASSPHRASE=

# Deployed sla_vault contract ID. Supplied after the contract is deployed to
# the target network by the slasettle-vault team.
NEXT_PUBLIC_SLA_VAULT_CONTRACT_ID=

# Deployed watcher_registry contract ID. Supplied after the contract is
# deployed to the target network by the slasettle-vault team.
NEXT_PUBLIC_WATCHER_REGISTRY_CONTRACT_ID=

# Base URL of the SLASettle indexer API. Supplied once the indexer is
# deployed and reachable.
NEXT_PUBLIC_INDEXER_API_URL=
