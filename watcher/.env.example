# This file is a template. The watcher does not load .env itself: export
# these variables in the shell or supervisor that starts it. Quote
# NETWORK_PASSPHRASE (spaces and ';') or omit it to use the default.
#
# Required
WATCHER_REGISTRY_CONTRACT_ID=
# This watcher's own Stellar secret key (S...). It must already be
# registered via watcher_registry.register_watcher by the contract admin
# before this daemon's votes will be accepted.
WATCHER_SECRET_KEY=
# The endpoint this watcher instance checks, once per round.
TARGET_URL=
# Which SLA this watcher instance is voting on. Run one process per SLA if
# watching more than one.
SLA_ID=

# Optional — defaults shown
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ROUND_LENGTH_SECONDS=60
HTTP_TIMEOUT_SECONDS=10
HTTP_EXPECT_MAX_STATUS=400
